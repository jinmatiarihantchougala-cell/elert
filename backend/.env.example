PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/silent-sos
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5500

# Use dev mode until real providers are configured; development mode does not claim delivery.
NOTIFICATION_MODE=dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=Silent SOS <alerts@example.com>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
